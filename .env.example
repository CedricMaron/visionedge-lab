# VisionEdge Lab — environment configuration.
# Copy to .env and adjust. All backend vars are prefixed VE_.

# --- server ---
VE_HOST=0.0.0.0
VE_PORT=8000
# Comma-separated allowed origins. "*" for local dev only; set explicit origins in prod.
VE_CORS_ORIGINS=*

# Per-IP limit on endpoints that run real inference (/api/infer, /api/vlm/*,
# /api/detection/benchmark). 0 disables it, which is fine locally. Set a real
# value for anything internet-facing: each request is a model forward pass.
VE_RATE_LIMIT_PER_MIN=0

# --- detection defaults ---
VE_DEFAULT_MODEL_ID=yolov8n-onnx
VE_DEFAULT_CONFIDENCE=0.25
VE_DEFAULT_IOU=0.45
VE_DEFAULT_INPUT_SIZE=640

# --- transport / backpressure ---
VE_MAX_FRAME_QUEUE=2
VE_MAX_UPLOAD_BYTES=8388608

# --- VLM ---
VE_DEFAULT_VLM_ID=mock-vlm
# Remote VLM (opt-in). Leave URL empty to disable remote entirely.
# Example: an OpenAI-compatible endpoint (self-hosted vLLM, etc.). Use https for TLS.
VE_VLM_REMOTE_URL=
VE_VLM_REMOTE_API_KEY=
VE_VLM_REMOTE_TIMEOUT_S=30
VE_VLM_REMOTE_MAX_RETRIES=2
# Privacy gate: frames are sent to the remote server ONLY when this is true.
VE_ALLOW_FRAME_TRANSMISSION=false

# --- logging ---
VE_LOG_JSON=true
VE_LOG_LEVEL=INFO

# --- frontend (Vite) ---
# Base URL the browser uses to reach the backend. Do NOT hardcode a LAN IP in code;
# set it here per-environment. For phone-on-LAN use, set your PC's LAN IP + https.
# Leave EMPTY for a same-origin deployment behind a reverse proxy: the app then
# resolves the API base to the origin it was served from.
VITE_API_BASE=http://localhost:8000

# --- production deployment (docker-compose.prod.yml) ---
# Hostname Caddy serves and requests a certificate for.
SITE_ADDRESS=visionedge.c-maron.space
# Suggested production overrides:
#   VE_CORS_ORIGINS=https://visionedge.c-maron.space
#   VE_RATE_LIMIT_PER_MIN=60
#   VE_DB_PATH=/data/visionedge.db      (mounted volume, or history is lost on restart)
#   VITE_API_BASE=                      (empty => same origin)
