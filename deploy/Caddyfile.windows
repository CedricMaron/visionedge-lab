# Caddy config for the VPS - native Windows, no Docker.
#
# This one Caddy instance is the only listener on ports 80/443, so it fronts
# every site on the box:
#   c-maron.space (+www)      -> the static portfolio
#   visionedge.c-maron.space  -> VisionEdge Lab (this repo): SPA + API
#   myalphaedge.com (+www)    -> MyAlphaEdge: SPA + API
#
# Editing this file therefore affects all three. ALWAYS validate before
# reloading - an invalid Caddyfile takes every site down, not just the one you
# changed:
#   $caddy = "C:\ProgramData\VisionEdge\tools\caddy.exe"
#   & $caddy validate --config C:\visionedge-lab\deploy\Caddyfile.windows --adapter caddyfile
#   & $caddy reload   --config C:\visionedge-lab\deploy\Caddyfile.windows --adapter caddyfile
#
# Two Caddyfile rules this file depends on:
#   - Windows paths use FORWARD slashes; a backslash is an escape character
#     inside Caddyfile tokens.
#   - A matcher-less `header` does not reliably lose to a later matched one, so
#     where two Cache-Control policies coexist they use mutually exclusive
#     matchers rather than relying on override order.

# --- portfolio ---------------------------------------------------------------
# Root is C:/inetpub/c-maron, which is where c-maron's scripts\deploy.ps1
# publishes (its $Target). It is NOT C:/inetpub/wwwroot: that is the IIS default
# directory and still holds a stale build, which is what made this domain serve
# the wrong site.
{$PORTFOLIO_ADDRESS:c-maron.space}, www.{$PORTFOLIO_ADDRESS:c-maron.space} {
	encode zstd gzip
	root * {$PORTFOLIO_ROOT:C:/inetpub/c-maron}
	file_server

	# Mirrors the headers IIS was already sending, so moving the site to Caddy
	# does not quietly relax its security posture.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}

	log {
		output file {$PORTFOLIO_LOG:C:/visionedge-lab/logs/portfolio.log} {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}

# --- VisionEdge Lab ----------------------------------------------------------
{$SITE_ADDRESS:visionedge.c-maron.space} {
	encode zstd gzip

	# Rate limiting lives in the backend (app/api/ratelimit.py) - Caddy v2 has no
	# built-in rate_limit directive. The backend keys on X-Forwarded-For, which is
	# trustworthy only because trusted_proxies is empty here and Caddy overwrites
	# any client-supplied value with the real peer address.

	# /health is part of the API surface but sits outside /api.
	handle /health {
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/* {
		# WebSocket upgrades (/api/ws/detect) need no extra directives.
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * {$SITE_ROOT:C:/visionedge-lab/frontend/dist}
		try_files {path} /index.html
		file_server
	}

	# NOTE: camera=(self), unlike the portfolio's camera=(). Live Inference calls
	# getUserMedia, and a restrictive Permissions-Policy here would silently break
	# it with no error the user could act on.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}

	log {
		output file {$SITE_LOG:C:/visionedge-lab/logs/caddy.log} {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}

# --- MyAlphaEdge -------------------------------------------------------------
# Nothing sits in front of this any more, so Caddy does the whole job: TLS, the
# SPA, and the API proxy. The hostname must appear in a site block or Caddy never
# requests a certificate for it - that absence, not DNS or ACME, is why this
# domain failed the TLS handshake.
{$MYALPHAEDGE_ADDRESS:myalphaedge.com} {
	encode zstd gzip

	# `handle`, not `handle_path`: the backend's routes all live under /api, so
	# the prefix must survive proxying.
	handle /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	handle {
		root * {$MYALPHAEDGE_ROOT:C:/MyAlphaEdge/frontend/dist}
		try_files {path} /index.html
		file_server
	}

	# Matched on "not /assets/*" rather than "*.html" on purpose. SPA routes like
	# /dashboard are served index.html under a path with no .html suffix, so an
	# *.html matcher would leave them with no directive and browsers would cache
	# them heuristically - serving a stale index.html that references chunk hashes
	# which no longer exist after a deploy. The two matchers are mutually
	# exclusive so neither depends on overriding the other.
	@assets path /assets/*
	@document not path /assets/*
	header @document Cache-Control "no-cache"
	header @assets Cache-Control "public, max-age=31536000, immutable"

	log {
		output file {$MYALPHAEDGE_LOG:C:/visionedge-lab/logs/myalphaedge.log} {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}

# All SEO canonicals and sitemap.xml use the bare apex, so www must not serve a
# duplicate copy of the site.
www.{$MYALPHAEDGE_ADDRESS:myalphaedge.com} {
	redir https://{$MYALPHAEDGE_ADDRESS:myalphaedge.com}{uri} permanent
}
